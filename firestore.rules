rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath());
    }

    function hasRole(allowedRoles) {
      return hasProfile() && get(profilePath()).data.role in allowedRoles;
    }

    function clubLeaders() {
      return hasRole(['President', 'Club Advisor', 'EC Officer']);
    }

    function canRead(collectionName) {
      return hasRole(['President', 'Club Advisor', 'EC Officer', 'Member'])
        || (hasRole(['VP Education'])
          && collectionName in ['meetings', 'attendance', 'mentors', 'settings', 'elections', 'supportTickets', 'reminders', 'ecChat'])
        || (hasRole(['VP Membership'])
          && collectionName in ['members', 'meetings', 'attendance', 'settings', 'elections', 'supportTickets', 'reminders', 'ecChat'])
        || (hasRole(['VP Public Relations'])
          && collectionName in ['meetings', 'settings', 'media', 'elections', 'supportTickets', 'reminders', 'ecChat'])
        || (hasRole(['Secretary'])
          && collectionName in ['meetings', 'attendance', 'settings', 'elections', 'supportTickets', 'reminders', 'ecChat'])
        || (hasRole(['Sergeant-at-Arms'])
          && collectionName in ['meetings', 'settings', 'elections', 'supportTickets', 'reminders', 'ecChat']);
    }

    function canWrite(collectionName) {
      return (collectionName == 'members' && hasRole(['President', 'Club Advisor', 'EC Officer', 'VP Membership']))
        || (collectionName == 'meetings' && (clubLeaders() || hasRole(['VP Education', 'Secretary'])))
        || (collectionName == 'attendance' && hasRole(['President', 'Club Advisor', 'EC Officer', 'VP Membership', 'Secretary', 'VP Education']))
        || (collectionName == 'mentors' && (clubLeaders() || hasRole(['VP Education'])))
        || (collectionName == 'settings' && hasRole(['President']))
        || (collectionName == 'media' && hasRole(['President', 'Club Advisor', 'EC Officer', 'VP Public Relations']))
        || (collectionName == 'elections' && (clubLeaders() || hasRole(['VP Education', 'Secretary'])))
        || (collectionName == 'reminders' && (clubLeaders() || hasRole(['VP Education', 'Secretary'])))
        || (collectionName == 'ecChat' && (clubLeaders() || hasRole(['VP Education', 'VP Membership', 'VP Public Relations', 'Secretary', 'Sergeant-at-Arms', 'Member'])));
    }

    function canAppendOwnVote() {
      return hasProfile()
        && resource.data.votes is list
        && request.resource.data.votes is list
        && request.resource.data.votes.size() == resource.data.votes.size() + 1
        && request.resource.data.votes.toSet().hasAll(resource.data.votes.toSet())
        && request.resource.data.votes[resource.data.votes.size()].voterKey == request.auth.uid;
    }

    function canReadECChat() {
      return resource.data.conversationId == 'general'
        || (resource.data.conversationId == 'ec-leadership' && (clubLeaders() || hasRole(['VP Education', 'VP Membership', 'VP Public Relations', 'Secretary', 'Sergeant-at-Arms'])))
        || clubLeaders()
        || resource.data.senderEmail == request.auth.token.email
        || resource.data.recipientEmail == request.auth.token.email
        || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid);
    }

    function canCreateECChat() {
      return request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 3000
        && (request.resource.data.senderUid == request.auth.uid || request.resource.data.senderEmail == request.auth.token.email || clubLeaders())
        && (request.resource.data.conversationId != 'ec-leadership' || clubLeaders() || hasRole(['VP Education', 'VP Membership', 'VP Public Relations', 'Secretary', 'Sergeant-at-Arms']));
    }

    function canDeleteECChat() {
      return clubLeaders()
        || resource.data.senderEmail == request.auth.token.email
        || (resource.data.senderUid != null && resource.data.senderUid == request.auth.uid);
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /clubs/{clubId}/{collectionName}/{recordId} {
      allow read: if canRead(collectionName)
        && (collectionName != 'supportTickets'
          || clubLeaders()
          || resource.data.createdByUid == request.auth.uid)
        && (collectionName != 'ecChat' || canReadECChat());
      allow create: if canWrite(collectionName)
        && (collectionName != 'ecChat' || canCreateECChat())
        || (collectionName == 'supportTickets'
          && hasProfile()
          && request.resource.data.createdByUid == request.auth.uid);
      allow delete: if canWrite(collectionName)
        && (collectionName != 'ecChat' || canDeleteECChat());
      allow update: if canWrite(collectionName)
        || (collectionName == 'elections'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && canAppendOwnVote());
    }

    match /clubs/{clubId}/auditLogs/{logId} {
      allow read: if hasRole(['President']);
      allow create: if hasProfile()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['collection', 'recordId', 'action', 'actorUid', 'recordedAt']);
      allow update, delete: if false;
    }
  }
}
